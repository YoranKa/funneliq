# Copy this file to .env and fill in real values. .env is gitignored;
# this file (.env.example) is committed so anyone cloning the repo knows
# which variables they need to set.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Server-side only - never ships to the browser, never used in notebooks.
SUPABASE_SERVICE_ROLE_KEY=
