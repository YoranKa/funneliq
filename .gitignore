# ---------------------------------------------------------------
# Secrets - NEVER commit these.
# Supabase keys, Railway config, and anything else sensitive lives
# in environment variables loaded from a local .env file.
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# ---------------------------------------------------------------
# Python virtual environment + generated files
# These are rebuilt from requirements.txt, so storing them adds
# thousands of files to history for zero benefit.
# ---------------------------------------------------------------
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------
# Trained model artifacts
# Regenerated by the training scripts; binary files bloat git history.
# ---------------------------------------------------------------
models/*.pkl
models/*.joblib
models/*.cbm
models/*.txt

# ---------------------------------------------------------------
# Data
# DECISION: data/funnel_marketing_data.csv IS committed on purpose.
# The brief says to keep "data dumps" out of the repo, and that rule
# is right for large or personal data. This file is a 200 KB seed
# dataset with no personal information, and committing it is what
# lets someone clone the repo and reproduce the whole project - which
# the brief also requires. Any LARGER or generated data is ignored below.
# ---------------------------------------------------------------
data/*.parquet
data/processed/
data/exports/
*.sqlite
*.db

# ---------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
